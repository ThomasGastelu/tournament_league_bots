# Copie ce fichier en .env et remplis-le. Ne partage jamais ton .env !

# --- Discord --------------------------------------------------------------
# Token du bot tournament_manager (Discord Developer Portal > ton application > Bot > Reset Token).
# Ce doit être une AUTRE application que le bot d'inscription.
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
# Avec cet ID, les commandes apparaissent tout de suite sur ce serveur.
GUILD_ID=

# Salon où le bot poste les annonces (zones de chaque round, matchs à valider, classement final).
# Clic droit sur le salon > Copier l'identifiant (mode développeur activé dans Discord).
# Vide : le bot poste dans le salon où le tournoi a été créé avec le bot d'inscription.
SALON_ANNONCES=

# Salon des alertes et des problèmes du bot (connexion impossible, scores à vérifier, erreurs…).
# Mets un salon PRIVÉ (admins seulement) : les alertes contiennent les mots de passe des parties.
# Vide : les alertes partent en MP à l'admin qui a lancé le tournoi.
LOG_CHANNEL=

# Salon où le bot poste le récap de chaque round terminé (scores de chaque zone et classement),
# par exemple #resultat-match. Vide : le récap part dans le salon des annonces.
SALON_RESULTATS=

# --- Fichiers (chemins relatifs au dossier rl_tournament_manager) ----------
# Dossier des fichiers d'inscription <id_tournoi>.json (lus, jamais modifiés).
DOSSIER_INSCRIPTIONS=../rl_bot_ppname_creator/data/tournois
# Les parties privées s'appellent tomato_A, tomato_B… (une lettre par zone) : plus besoin de SCRIPT_PP.

# --- Déroulement ----------------------------------------------------------
# Pause entre deux rounds, en secondes.
PAUSE_ENTRE_RONDES=60
# Le capitaine qui crée la partie privée clique sur « Partie privée créée ». Sans clic : rappel au
# capitaine après RAPPEL_CLIC_PP secondes, puis après ATTENTE_CLIC_PP_MAX secondes le bot fait comme
# si la partie était créée (avec une alerte).
RAPPEL_CLIC_PP=180
ATTENTE_CLIC_PP_MAX=600
# Secondes entre le clic « Partie privée créée » et le MP qui demande aux joueurs de déclarer le score
# (360 = 6 minutes). Mets par exemple 5 pour tester un tournoi sans jouer.
DELAI_DECLARATION=360
# TESTS UNIQUEMENT : impose le nom et le mot de passe de la partie privée de la zone 2
# (format nom:mot_de_passe ; sans « : », mot de passe = nom). Laisse vide en vrai tournoi.
PP_FORCEE_ZONE_2=

# --- Simulation (tests sans joueurs) ---------------------------------------
# 1 : le tournoi se joue tout seul (clic « Partie privée créée » et déclarations des scores automatiques).
# Les vrais MP partent quand même aux joueurs inscrits : remets 0 avant un vrai tournoi.
SIMULATION=0
# Secondes avant le clic automatique « Partie privée créée ».
SIMULATION_DELAI_CLIC=5
# Secondes entre le MP de déclaration et les déclarations automatiques des deux équipes.
SIMULATION_DELAI_DECLARATION=5
# Probabilité (0 à 1) que les deux équipes déclarent des scores différents (un admin doit trancher).
SIMULATION_PROBA_DESACCORD=0
