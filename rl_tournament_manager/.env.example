# Copie ce fichier en .env et remplis-le. Ne partage jamais ton .env !

# --- Discord --------------------------------------------------------------
# Token du bot tournament_manager (Discord Developer Portal > ton application > Bot > Reset Token).
# Ce doit être une AUTRE application que le bot d'inscription.
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
# Avec cet ID, les commandes apparaissent tout de suite sur ce serveur.
GUILD_ID=

# Salon où le bot poste les annonces (zones de chaque round, matchs à valider, classement final).
# Clic droit sur le salon > Copier l'identifiant (mode développeur activé dans Discord).
# Vide : le bot poste dans le salon où le tournoi a été créé avec le bot d'inscription.
SALON_ANNONCES=

# Salon des alertes et des problèmes du bot (connexion impossible, scores à vérifier, erreurs…).
# Mets un salon PRIVÉ (admins seulement) : les alertes contiennent les mots de passe des parties.
# Vide : les alertes partent en MP à l'admin qui a lancé le tournoi.
LOG_CHANNEL=

# --- Fichiers (chemins relatifs au dossier rl_tournament_manager) ----------
# Dossier des fichiers d'inscription <id_tournoi>.json (lus, jamais modifiés).
DOSSIER_INSCRIPTIONS=../rl_bot_ppname_creator/data/tournois
# Script qui génère les noms / mots de passe de parties privées.
SCRIPT_PP=../rl_bot_ppname_creator/generer_pp_names.py

# --- Déroulement ----------------------------------------------------------
# Pause entre deux rounds, en secondes.
PAUSE_ENTRE_RONDES=60
# Le capitaine qui crée la partie privée clique sur « Partie privée créée » : le bot commence alors
# à prendre le score de ce match. Sans clic : rappel au capitaine après RAPPEL_CLIC_PP secondes,
# puis après ATTENTE_CLIC_PP_MAX secondes le bot passe quand même dans la partie (avec une alerte).
RAPPEL_CLIC_PP=180
ATTENTE_CLIC_PP_MAX=600
# TESTS UNIQUEMENT : impose le nom et le mot de passe de la partie privée de la zone 2
# (format nom:mot_de_passe ; sans « : », mot de passe = nom). Laisse vide en vrai tournoi.
PP_FORCEE_ZONE_2=

# --- Observation des matchs -----------------------------------------------
# simulation : résultats aléatoires, pour tester sans jouer
# rl         : vrai connecteur rl_api_pp_connector (le bot rejoint les parties dans Rocket League)
OBSERVATEUR=simulation

# --- Vrai connecteur (seulement avec OBSERVATEUR=rl) ----------------------
# Tous les matchs se jouent en même temps ; le bot passe dans les parties l'une après l'autre.
# Dossier de rl_api_pp_connector (rl_join_bot.py, positions.json).
RL_DOSSIER_CONNECTEUR=../rl_api_pp_connector
# Résolution de l'écran du jeu, ex. 1920x1200. Vide : celle de la calibration (positions.json).
RL_RESOLUTION=
# Langue de Rocket League : en ou fr.
RL_LANGUE=en
# Échecs de suite avant d'abandonner une partie (les joueurs déclarent alors le score).
RL_TENTATIVES=3
# Secondes max pour entrer dans une partie.
RL_TIMEOUT_REJOINDRE=45
# Pause entre deux écrans de menu (augmente si le PC est lent).
RL_DELAI_MENUS=1.5
# Secondes passées dans chaque partie pour lire le score.
RL_DUREE_LECTURE=5
# Secondes d'attente après avoir quitté une partie (retour au menu principal).
RL_PAUSE_APRES_SORTIE=8
# Appuis sur Échap pour revenir au menu principal après un échec de connexion (fenêtre d'erreur, connexion, Match privé, Jouer).
RL_ECHAP_RETOUR_MENU=4

# --- Simulation (seulement avec OBSERVATEUR=simulation) -------------------
# Durée d'un match simulé, en secondes (tirée au hasard entre MIN et MAX).
SIMULATION_DUREE_MIN=10
SIMULATION_DUREE_MAX=30
# Probabilité (0 à 1) que le bot n'ait pas le score → les joueurs le déclarent (bouton en MP).
SIMULATION_PROBA_SANS_GAGNANT=0
# Probabilité (0 à 1) que les équipes se trompent de couleur (le bot doit le voir grâce aux pseudos).
SIMULATION_PROBA_COULEURS_INVERSEES=0.2
