# Copie ce fichier en .env et remplis-le. Ne partage jamais ton .env !

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
# Avec cet ID, la commande /ticket_panel apparaît tout de suite sur ce serveur.
GUILD_ID=

# ID de la catégorie où créer les tickets (clic droit sur la catégorie > Copier l'identifiant).
# Vide : le bot utilise la catégorie « Support » et la crée si elle n'existe pas.
CATEGORIE_TICKETS=

# ID des rôles du staff qui voient et gèrent les tickets, séparés par des virgules.
# Ex : ROLES_STAFF=123456789012345678,234567890123456789
ROLES_STAFF=

# Facultatif : ID du salon (réservé au staff) où le bot note les tickets ouverts / fermés
# et dépose la copie de la conversation à la fermeture.
LOG_CHANNEL=
