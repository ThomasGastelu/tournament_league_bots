# Copie ce fichier en .env et remplis-le. Ne partage jamais ton .env !

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
# Avec cet ID, la commande /mp_all apparaît tout de suite sur ce serveur.
GUILD_ID=
