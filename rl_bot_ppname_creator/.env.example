# Copie ce fichier en .env et remplis-le. Ne partage jamais ton .env !

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
# Avec cet ID, les commandes apparaissent tout de suite sur ce serveur.
GUILD_ID=

# Temps (en minutes) laissé aux coéquipiers pour confirmer leur participation.
# Passé ce délai, l'équipe est désinscrite du tournoi. Redémarre le bot après un changement.
DELAI_CONFIRMATION_MINUTES=30
